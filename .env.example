# Copy to .env before the first start:  cp .env.example .env
# All values below are for local development only.

# --- PostgreSQL ---
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_password
DB_NAME=ohbeat
# Owner of the schema: runs migrations and seeds (GAP-5)
DB_OWNER_USER=ohbeat_owner
DB_OWNER_PASSWORD=owner_dev_password
# Login user of Core API, member of the NOLOGIN role ohbeat_app from schema.sql (GAP-5)
DB_APP_USER=ohbeat_api
DB_APP_PASSWORD=api_dev_password

# --- RabbitMQ ---
RABBITMQ_USER=ohbeat
RABBITMQ_PASSWORD=rabbit_dev_password

# --- MinIO (S3) ---
MINIO_ROOT_USER=ohbeat
MINIO_ROOT_PASSWORD=minio_dev_password
# Address the browser uses to reach MinIO; presigned links are signed for this host
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- Auth ---
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=3600
# ASSUMPTION: GAP-11
REFRESH_TOKEN_TTL_DAYS=30

# --- Platform settings (GAP-10) ---
PLATFORM_FEE_PERCENT=10
VOICE_TAG_INTERVAL_SEC=20

# --- Development seed accounts ---
SEED_ARTIST_EMAIL=artist@example.com
SEED_ARTIST_PASSWORD=Artist123!
SEED_PRODUCER_EMAIL=producer@example.com
SEED_PRODUCER_PASSWORD=Producer123!
SEED_PRODUCER_YOOKASSA_ACCOUNT_ID=mock-seller-1001
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
